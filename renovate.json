{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":configMigration",
        "helpers:pinGitHubActionDigests"
    ],
    "prHourlyLimit": 0,
    "prConcurrentLimit": 0,
    "enabledManagers": [
        "github-actions",
        "custom.jsonata"
    ],
    "customManagers": [
        {
            "customType": "jsonata",
            "fileFormat": "json",
            "managerFilePatterns": [ "rocks.json" ],
            "matchStrings": [
                "[download,build].{ \"depName\": name, \"currentValue\": tag, \"packageName\": repo, \"datasource\": \"github-releases\" }"
            ]
        }
    ]

}